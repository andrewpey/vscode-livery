{
  "name": "livery",
  "displayName": "Livery",
  "icon": "media/icon.png",
  "description": "A little color for each VS Code workspace, so you can tell projects apart at a glance.",
  "version": "1.0.2",
  "publisher": "andrewpey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewpey/vscode-livery.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "workspace",
    "status bar",
    "color",
    "workspace color",
    "project color"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.cjs",
    "vscode:prepublish": "npm run build"
  },
  "contributes": {
    "commands": [
      {
        "command": "livery.chooseColor",
        "title": "Choose Color",
        "category": "Livery"
      },
      {
        "command": "livery.randomColor",
        "title": "Random Color",
        "category": "Livery"
      },
      {
        "command": "livery.reset",
        "title": "Reset",
        "category": "Livery"
      },
      {
        "command": "livery.applyPreview",
        "title": "Apply Preview",
        "category": "Livery",
        "enablement": "resourceScheme == livery-preview"
      },
      {
        "command": "livery.cancelPreview",
        "title": "Cancel Preview",
        "category": "Livery",
        "enablement": "resourceScheme == livery-preview"
      }
    ],
    "configuration": {
      "title": "Livery",
      "properties": {
        "livery.baseColor": {
          "type": "string",
          "default": "",
          "scope": "window",
          "anyOf": [
            {
              "enum": [
                ""
              ]
            },
            {
              "format": "color-hex"
            }
          ],
          "pattern": "^(#[0-9a-fA-F]{6}|#[0-9a-fA-F]{3})?$",
          "markdownDescription": "Workspace status bar color. Choose a color and save to apply."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.85.0",
    "typescript": "~5.9.3"
  }
}
